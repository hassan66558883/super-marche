# ─── TECHNOVA POS — production settings for docker compose ───
# Copy to .env and replace every CHANGE_ME. Never commit .env.

# Public host name of the shop server (used for HTTPS and CORS), e.g. pos.mon-supermarche.td
SERVER_NAME=localhost
HTTP_PORT=80
HTTPS_PORT=443
# Folder holding fullchain.pem + privkey.pem (a self-signed pair is generated if empty)
CERTS_DIR=./nginx/certs
TZ=Africa/Ndjamena
# Set to 0 when certificates are always mounted: the web image then skips installing OpenSSL
SELF_SIGNED_CERT=1
# Base Node image for the builds (e.g. a registry mirror, or node:22-bookworm which already ships OpenSSL)
NODE_IMAGE=node:22-bookworm-slim

# Database
POSTGRES_DB=technova
POSTGRES_USER=technova
# openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME

# API secrets — openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
REFRESH_TTL_HOURS=12
REFRESH_TTL_REMEMBER_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# First start only (docker compose run --rm api node dist/cli/bootstrap.js).
# Remove the password from this file once the administrator exists.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_COMPANY_NAME=TECHNOVA POS
BOOTSTRAP_BRANCH_CODE=NDJ
BOOTSTRAP_BRANCH_NAME=Siège
BOOTSTRAP_BRANCH_CITY=N'Djamena

# Backups (pg_dump every day at BACKUP_HOUR, kept BACKUP_KEEP_DAYS days)
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=30
