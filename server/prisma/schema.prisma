// TECHNOVA POS — PostgreSQL schema
// Conventions:
//  - UUID primary keys, snake_case tables/columns via @@map/@map
//  - Money: NUMERIC(15,2); quantities: NUMERIC(14,3) (supports kg/l)
//  - Financial and stock history is never deleted: statuses + DB triggers (see migrations)
//  - Some indexes/triggers live only in SQL migrations (pg_trgm search, inventory NULLS NOT DISTINCT).
//    Prisma cannot see them and will propose DROP INDEX in new migrations: create migrations with
//    `npm run db:migration:new`, remove any such DROP statements, then apply with `npm run db:migrate`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  WALK_IN
  REGISTERED
  BUSINESS
}

enum PriceMode {
  EXCLUSIVE
  INCLUSIVE
}

enum DiscountType {
  PERCENT
  FIXED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentStatus {
  PAID
  PARTIAL
  CREDIT
}

enum PaymentMethodType {
  CASH
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
  CREDIT
  OTHER
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentRecordStatus {
  COMPLETED
  VOID
}

enum ReturnReason {
  DAMAGED
  WRONG_PRODUCT
  CUSTOMER_REQUEST
  OTHER
}

enum ReturnStatus {
  COMPLETED
  VOID
}

enum MovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  DAMAGE
  OPENING
}

enum TransferStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum RegisterSessionStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  OPEN
  SALE
  REFUND
  EXPENSE
  CASH_IN
  CASH_OUT
  CLOSE
}

enum LedgerEntryType {
  SALE
  PAYMENT
  REFUND
  ADJUSTMENT
  PURCHASE
}

enum ExpenseStatus {
  RECORDED
  VOID
}

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  CREATE
  UPDATE
  DELETE
  SALE
  RETURN
  PAYMENT
  STOCK_ADJUSTMENT
  PRICE_CHANGE
  CASH_REGISTER_OPEN
  CASH_REGISTER_CLOSE
  CANCEL
  APPROVE
  RECEIVE
  PASSWORD_CHANGE
  EXPORT
}

enum NotificationType {
  LOW_STOCK
  OUT_OF_STOCK
  LARGE_DISCOUNT
  SALE_CANCELLED
  CASH_DISCREPANCY
  PENDING_PURCHASE
  PENDING_TRANSFER
}

// ─────────────────────── Identity & access ───────────────────────

model User {
  id                String     @id @default(uuid()) @db.Uuid
  username          String     @unique
  email             String?    @unique
  fullName          String     @map("full_name")
  phone             String?
  passwordHash      String     @map("password_hash")
  status            UserStatus @default(ACTIVE)
  locale            String     @default("fr")
  theme             String     @default("light")
  defaultBranchId   String?    @map("default_branch_id") @db.Uuid
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until")
  passwordChangedAt DateTime?  @map("password_changed_at")
  lastLoginAt       DateTime?  @map("last_login_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  defaultBranch    Branch?               @relation("UserDefaultBranch", fields: [defaultBranchId], references: [id])
  roles            UserRole[]
  branches         UserBranch[]
  sessions         UserSession[]
  resetTokens      PasswordResetToken[]
  sales            Sale[]
  returns          Return[]
  registerSessions CashRegisterSession[] @relation("SessionOpenedBy")
  closedSessions   CashRegisterSession[] @relation("SessionClosedBy")
  auditLogs        AuditLog[]
  heldSales        HeldSale[]

  @@map("users")
}

model Role {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  name               String
  description        String?
  isSystem           Boolean  @default(false) @map("is_system")
  // Max discount (percent of line/cart) this role can grant without override
  maxDiscountPercent Decimal  @default(0) @map("max_discount_percent") @db.Decimal(5, 2)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // e.g. products.create
  module      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model UserBranch {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

// Refresh-token sessions (rotated on every refresh; token stored hashed)
model UserSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")
  rememberMe Boolean   @default(false) @map("remember_me")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ───────────────────────── Organisation ─────────────────────────

model Branch {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique // used in invoice numbers, e.g. NDJ
  name         String
  address      String?
  city         String?
  phone        String?
  email        String?
  isHeadOffice Boolean      @default(false) @map("is_head_office")
  defaultTaxId String?      @map("default_tax_id") @db.Uuid
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  defaultTax      Tax?                @relation(fields: [defaultTaxId], references: [id])
  users           UserBranch[]
  defaultForUsers User[]              @relation("UserDefaultBranch")
  inventory       Inventory[]
  movements       InventoryMovement[]
  sales           Sale[]
  returns         Return[]
  registers       CashRegister[]
  expenses        Expense[]
  purchaseOrders  PurchaseOrder[]
  transfersOut    StockTransfer[]     @relation("TransferFrom")
  transfersIn     StockTransfer[]     @relation("TransferTo")
  sequences       DocumentSequence[]
  payments        Payment[]
  heldSales       HeldSale[]
  notifications   Notification[]

  @@map("branches")
}

// Key/value settings, optionally scoped to a branch (null = company-wide)
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  branchId  String?  @map("branch_id") @db.Uuid
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([key, branchId])
  @@map("settings")
}

// Per-branch, per-document, per-year counters (invoice numbering)
model DocumentSequence {
  id        String @id @default(uuid()) @db.Uuid
  branchId  String @map("branch_id") @db.Uuid
  docType   String @map("doc_type") // SALE, RETURN, PURCHASE, TRANSFER
  year      Int
  lastValue Int    @default(0) @map("last_value")

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([branchId, docType, year])
  @@map("document_sequences")
}

// ─────────────────────────── Catalog ───────────────────────────

model Tax {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  code      String       @unique
  rate      Decimal      @db.Decimal(5, 2) // percent, e.g. 18.00
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products   Product[]
  categories Category[]
  branches   Branch[]

  @@map("taxes")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  nameAr    String?      @map("name_ar")
  nameEn    String?      @map("name_en")
  icon      String? // lucide icon name
  color     String? // hex
  parentId  String?      @map("parent_id") @db.Uuid
  taxId     String?      @map("tax_id") @db.Uuid
  sortOrder Int          @default(0) @map("sort_order")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  tax      Tax?       @relation(fields: [taxId], references: [id])
  products Product[]

  @@map("categories")
}

model Brand {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  products Product[]

  @@map("brands")
}

model Unit {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique // PCS, BOX, CTN, KG, G, L, ML, M
  name         String
  nameAr       String?  @map("name_ar")
  nameEn       String?  @map("name_en")
  allowDecimal Boolean  @default(false) @map("allow_decimal")
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("units")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  nameAr         String?      @map("name_ar")
  nameEn         String?      @map("name_en")
  sku            String       @unique
  reference      String?
  categoryId     String?      @map("category_id") @db.Uuid
  brandId        String?      @map("brand_id") @db.Uuid
  unitId         String?      @map("unit_id") @db.Uuid
  taxId          String?      @map("tax_id") @db.Uuid
  priceMode      PriceMode    @default(INCLUSIVE) @map("price_mode")
  purchasePrice  Decimal      @default(0) @map("purchase_price") @db.Decimal(15, 2)
  sellingPrice   Decimal      @map("selling_price") @db.Decimal(15, 2)
  wholesalePrice Decimal?     @map("wholesale_price") @db.Decimal(15, 2)
  minStock       Decimal      @default(0) @map("min_stock") @db.Decimal(14, 3)
  maxStock       Decimal?     @map("max_stock") @db.Decimal(14, 3)
  trackStock     Boolean      @default(true) @map("track_stock")
  isQuick        Boolean      @default(false) @map("is_quick") // shown on POS quick grid
  imageUrl       String?      @map("image_url")
  description    String?
  // What happens to returned goods: back to sellable stock or written off as damage
  returnToStock  Boolean      @default(true) @map("return_to_stock")
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  category  Category?           @relation(fields: [categoryId], references: [id])
  brand     Brand?              @relation(fields: [brandId], references: [id])
  unit      Unit?               @relation(fields: [unitId], references: [id])
  tax       Tax?                @relation(fields: [taxId], references: [id])
  variants  ProductVariant[]
  barcodes  ProductBarcode[]
  inventory Inventory[]
  movements InventoryMovement[]
  saleItems SaleItem[]

  purchaseItems PurchaseItem[]
  transferItems StockTransferItem[]
  returnItems   ReturnItem[]

  @@index([name])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id             String       @id @default(uuid()) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  name           String // e.g. "1.5 L", "Rouge / XL"
  sku            String       @unique
  sellingPrice   Decimal?     @map("selling_price") @db.Decimal(15, 2) // null = inherit
  wholesalePrice Decimal?     @map("wholesale_price") @db.Decimal(15, 2)
  purchasePrice  Decimal?     @map("purchase_price") @db.Decimal(15, 2)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  barcodes  ProductBarcode[]
  inventory Inventory[]
  movements InventoryMovement[]
  saleItems SaleItem[]

  purchaseItems PurchaseItem[]
  transferItems StockTransferItem[]
  returnItems   ReturnItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductBarcode {
  id        String   @id @default(uuid()) @db.Uuid
  barcode   String   @unique
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_barcodes")
}

// ────────────────────────── Inventory ──────────────────────────

// One row per (branch, product, variant). variant_id NULL = base product.
// Uniqueness enforced with NULLS NOT DISTINCT in migration.
model Inventory {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  quantity  Decimal  @default(0) @db.Decimal(14, 3)
  reserved  Decimal  @default(0) @db.Decimal(14, 3) // e.g. approved outgoing transfers
  updatedAt DateTime @updatedAt @map("updated_at")

  branch  Branch          @relation(fields: [branchId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([branchId])
  @@index([productId])
  @@map("inventory")
}

// Append-only stock ledger. Every stock change writes one row here.
model InventoryMovement {
  id            String       @id @default(uuid()) @db.Uuid
  branchId      String       @map("branch_id") @db.Uuid
  productId     String       @map("product_id") @db.Uuid
  variantId     String?      @map("variant_id") @db.Uuid
  type          MovementType
  quantity      Decimal      @db.Decimal(14, 3) // signed: + in, - out
  balanceAfter  Decimal      @map("balance_after") @db.Decimal(14, 3)
  unitCost      Decimal?     @map("unit_cost") @db.Decimal(15, 2)
  referenceType String?      @map("reference_type") // SALE, RETURN, PURCHASE, TRANSFER, ADJUSTMENT
  referenceId   String?      @map("reference_id") @db.Uuid
  reference     String? // human readable (invoice no.)
  note          String?
  userId        String       @map("user_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at")

  branch  Branch          @relation(fields: [branchId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([branchId, createdAt])
  @@index([productId, createdAt])
  @@index([referenceId])
  @@map("inventory_movements")
}

model StockTransfer {
  id           String         @id @default(uuid()) @db.Uuid
  number       String         @unique
  fromBranchId String         @map("from_branch_id") @db.Uuid
  toBranchId   String         @map("to_branch_id") @db.Uuid
  status       TransferStatus @default(DRAFT)
  note         String?
  createdById  String         @map("created_by_id") @db.Uuid
  approvedById String?        @map("approved_by_id") @db.Uuid
  shippedById  String?        @map("shipped_by_id") @db.Uuid
  receivedById String?        @map("received_by_id") @db.Uuid
  requestedAt  DateTime?      @map("requested_at")
  approvedAt   DateTime?      @map("approved_at")
  shippedAt    DateTime?      @map("shipped_at")
  receivedAt   DateTime?      @map("received_at")
  cancelledAt  DateTime?      @map("cancelled_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id])
  items      StockTransferItem[]

  @@index([fromBranchId, createdAt])
  @@index([toBranchId, createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String   @id @default(uuid()) @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  quantity         Decimal  @db.Decimal(14, 3)
  receivedQuantity Decimal? @map("received_quantity") @db.Decimal(14, 3)

  transfer StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("stock_transfer_items")
}

// ────────────────────── Customers & suppliers ──────────────────────

model Customer {
  id               String       @id @default(uuid()) @db.Uuid
  code             String       @unique
  type             CustomerType @default(REGISTERED)
  name             String
  phone            String?
  email            String?
  address          String?
  taxId            String?      @map("tax_id")
  creditLimit      Decimal      @default(0) @map("credit_limit") @db.Decimal(15, 2)
  balance          Decimal      @default(0) @db.Decimal(15, 2) // amount the customer owes us
  paymentTermsDays Int          @default(30) @map("payment_terms_days")
  notes            String?
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  sales    Sale[]
  entries  CustomerAccountEntry[]
  payments Payment[]

  @@index([phone])
  @@index([name])
  @@map("customers")
}

// Customer ledger: debit (+) increases what they owe, credit (-) reduces it
model CustomerAccountEntry {
  id           String          @id @default(uuid()) @db.Uuid
  customerId   String          @map("customer_id") @db.Uuid
  branchId     String          @map("branch_id") @db.Uuid
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(15, 2) // signed
  balanceAfter Decimal         @map("balance_after") @db.Decimal(15, 2)
  saleId       String?         @map("sale_id") @db.Uuid
  paymentId    String?         @map("payment_id") @db.Uuid
  dueDate      DateTime?       @map("due_date")
  description  String?
  userId       String          @map("user_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
  @@map("customer_accounts")
}

model Supplier {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  name         String
  company      String?
  phone        String?
  email        String?
  address      String?
  taxId        String?      @map("tax_id")
  paymentTerms String?      @map("payment_terms")
  balance      Decimal      @default(0) @db.Decimal(15, 2) // amount we owe the supplier
  status       RecordStatus @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  purchaseOrders PurchaseOrder[]
  entries        SupplierAccountEntry[]

  @@index([phone])
  @@map("suppliers")
}

model SupplierAccountEntry {
  id              String          @id @default(uuid()) @db.Uuid
  supplierId      String          @map("supplier_id") @db.Uuid
  branchId        String          @map("branch_id") @db.Uuid
  type            LedgerEntryType
  amount          Decimal         @db.Decimal(15, 2) // signed: + we owe more, - we paid
  balanceAfter    Decimal         @map("balance_after") @db.Decimal(15, 2)
  purchaseOrderId String?         @map("purchase_order_id") @db.Uuid
  paymentMethodId String?         @map("payment_method_id") @db.Uuid
  reference       String?
  description     String?
  userId          String          @map("user_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId, createdAt])
  @@map("supplier_accounts")
}

// ─────────────────────────── Sales ───────────────────────────

model PaymentMethod {
  id        String            @id @default(uuid()) @db.Uuid
  code      String            @unique
  name      String
  type      PaymentMethodType
  // Provider key for integrations (e.g. "airtel_money", "moov_money"); null = manual
  provider  String?
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  payments Payment[]

  @@map("payment_methods")
}

model Sale {
  id                String        @id @default(uuid()) @db.Uuid
  invoiceNumber     String        @unique @map("invoice_number")
  // Idempotency key from the client (offline sync safety)
  clientRef         String?       @unique @map("client_ref")
  branchId          String        @map("branch_id") @db.Uuid
  registerSessionId String?       @map("register_session_id") @db.Uuid
  cashierId         String        @map("cashier_id") @db.Uuid
  customerId        String?       @map("customer_id") @db.Uuid
  status            SaleStatus    @default(COMPLETED)
  paymentStatus     PaymentStatus @default(PAID) @map("payment_status")
  subtotal          Decimal       @db.Decimal(15, 2) // sum of qty * unit price
  lineDiscountTotal Decimal       @default(0) @map("line_discount_total") @db.Decimal(15, 2)
  cartDiscountType  DiscountType? @map("cart_discount_type")
  cartDiscountValue Decimal?      @map("cart_discount_value") @db.Decimal(15, 2)
  cartDiscountTotal Decimal       @default(0) @map("cart_discount_total") @db.Decimal(15, 2)
  discountTotal     Decimal       @default(0) @map("discount_total") @db.Decimal(15, 2)
  taxTotal          Decimal       @default(0) @map("tax_total") @db.Decimal(15, 2)
  total             Decimal       @db.Decimal(15, 2)
  costTotal         Decimal       @default(0) @map("cost_total") @db.Decimal(15, 2)
  amountPaid        Decimal       @default(0) @map("amount_paid") @db.Decimal(15, 2)
  amountDue         Decimal       @default(0) @map("amount_due") @db.Decimal(15, 2)
  amountTendered    Decimal       @default(0) @map("amount_tendered") @db.Decimal(15, 2)
  changeGiven       Decimal       @default(0) @map("change_given") @db.Decimal(15, 2)
  refundedTotal     Decimal       @default(0) @map("refunded_total") @db.Decimal(15, 2)
  dueDate           DateTime?     @map("due_date")
  note              String?
  cancelReason      String?       @map("cancel_reason")
  cancelledAt       DateTime?     @map("cancelled_at")
  cancelledById     String?       @map("cancelled_by_id") @db.Uuid
  offlineCreatedAt  DateTime?     @map("offline_created_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  branch          Branch               @relation(fields: [branchId], references: [id])
  cashier         User                 @relation(fields: [cashierId], references: [id])
  customer        Customer?            @relation(fields: [customerId], references: [id])
  registerSession CashRegisterSession? @relation(fields: [registerSessionId], references: [id])
  items           SaleItem[]
  payments        Payment[]
  returns         Return[]

  @@index([branchId, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([cashierId, createdAt])
  @@map("sales")
}

model SaleItem {
  id                String        @id @default(uuid()) @db.Uuid
  saleId            String        @map("sale_id") @db.Uuid
  productId         String        @map("product_id") @db.Uuid
  variantId         String?       @map("variant_id") @db.Uuid
  // Snapshots so history survives catalog edits
  productName       String        @map("product_name")
  sku               String
  quantity          Decimal       @db.Decimal(14, 3)
  unitPrice         Decimal       @map("unit_price") @db.Decimal(15, 2)
  originalPrice     Decimal       @map("original_price") @db.Decimal(15, 2)
  unitCost          Decimal       @default(0) @map("unit_cost") @db.Decimal(15, 2)
  discountType      DiscountType? @map("discount_type")
  discountValue     Decimal?      @map("discount_value") @db.Decimal(15, 2)
  discountAmount    Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2) // line discount
  cartDiscountShare Decimal       @default(0) @map("cart_discount_share") @db.Decimal(15, 2)
  taxId             String?       @map("tax_id") @db.Uuid
  taxRate           Decimal       @default(0) @map("tax_rate") @db.Decimal(5, 2)
  priceMode         PriceMode     @map("price_mode")
  taxAmount         Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  netAmount         Decimal       @map("net_amount") @db.Decimal(15, 2) // excl. tax
  total             Decimal       @db.Decimal(15, 2) // incl. tax, after discounts
  returnedQuantity  Decimal       @default(0) @map("returned_quantity") @db.Decimal(14, 3)

  sale        Sale            @relation(fields: [saleId], references: [id])
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// All money in/out of the business that relates to sales, refunds, customer settlements
model Payment {
  id                String              @id @default(uuid()) @db.Uuid
  branchId          String              @map("branch_id") @db.Uuid
  saleId            String?             @map("sale_id") @db.Uuid
  returnId          String?             @map("return_id") @db.Uuid
  customerId        String?             @map("customer_id") @db.Uuid
  paymentMethodId   String              @map("payment_method_id") @db.Uuid
  registerSessionId String?             @map("register_session_id") @db.Uuid
  direction         PaymentDirection    @default(IN)
  amount            Decimal             @db.Decimal(15, 2)
  reference         String? // card auth code, mobile money transaction id...
  providerStatus    String?             @map("provider_status")
  status            PaymentRecordStatus @default(COMPLETED)
  userId            String              @map("user_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")

  branch        Branch        @relation(fields: [branchId], references: [id])
  sale          Sale?         @relation(fields: [saleId], references: [id])
  return        Return?       @relation(fields: [returnId], references: [id])
  customer      Customer?     @relation(fields: [customerId], references: [id])
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([saleId])
  @@index([branchId, createdAt])
  @@index([customerId])
  @@map("payments")
}

model Return {
  id                String       @id @default(uuid()) @db.Uuid
  number            String       @unique
  saleId            String       @map("sale_id") @db.Uuid
  branchId          String       @map("branch_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  registerSessionId String?      @map("register_session_id") @db.Uuid
  reason            ReturnReason
  note              String?
  status            ReturnStatus @default(COMPLETED)
  subtotal          Decimal      @db.Decimal(15, 2)
  taxTotal          Decimal      @default(0) @map("tax_total") @db.Decimal(15, 2)
  total             Decimal      @db.Decimal(15, 2)
  createdAt         DateTime     @default(now()) @map("created_at")

  sale     Sale         @relation(fields: [saleId], references: [id])
  branch   Branch       @relation(fields: [branchId], references: [id])
  user     User         @relation(fields: [userId], references: [id])
  items    ReturnItem[]
  payments Payment[]

  @@index([branchId, createdAt])
  @@index([saleId])
  @@map("returns")
}

model ReturnItem {
  id         String  @id @default(uuid()) @db.Uuid
  returnId   String  @map("return_id") @db.Uuid
  saleItemId String  @map("sale_item_id") @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  variantId  String? @map("variant_id") @db.Uuid
  quantity   Decimal @db.Decimal(14, 3)
  unitPrice  Decimal @map("unit_price") @db.Decimal(15, 2) // effective incl. tax per unit
  taxAmount  Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)
  total      Decimal @db.Decimal(15, 2)
  restocked  Boolean @default(true)

  return   Return          @relation(fields: [returnId], references: [id])
  saleItem SaleItem        @relation(fields: [saleItemId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("return_items")
}

// Suspended carts ("Mettre en attente"). Not a financial record: no stock, no number.
model HeldSale {
  id         String   @id @default(uuid()) @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  label      String
  customerId String?  @map("customer_id") @db.Uuid
  cart       Json
  itemCount  Int      @map("item_count")
  total      Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  branch Branch @relation(fields: [branchId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([branchId, userId])
  @@map("held_sales")
}

// ────────────────────────── Purchasing ──────────────────────────

model PurchaseOrder {
  id            String         @id @default(uuid()) @db.Uuid
  number        String         @unique
  supplierId    String         @map("supplier_id") @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  status        PurchaseStatus @default(DRAFT)
  subtotal      Decimal        @default(0) @db.Decimal(15, 2)
  discountTotal Decimal        @default(0) @map("discount_total") @db.Decimal(15, 2)
  taxTotal      Decimal        @default(0) @map("tax_total") @db.Decimal(15, 2)
  total         Decimal        @default(0) @db.Decimal(15, 2)
  amountPaid    Decimal        @default(0) @map("amount_paid") @db.Decimal(15, 2)
  expectedAt    DateTime?      @map("expected_at")
  note          String?
  createdById   String         @map("created_by_id") @db.Uuid
  approvedById  String?        @map("approved_by_id") @db.Uuid
  receivedById  String?        @map("received_by_id") @db.Uuid
  approvedAt    DateTime?      @map("approved_at")
  receivedAt    DateTime?      @map("received_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  branch   Branch         @relation(fields: [branchId], references: [id])
  items    PurchaseItem[]

  @@index([branchId, createdAt])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseItem {
  id               String  @id @default(uuid()) @db.Uuid
  purchaseOrderId  String  @map("purchase_order_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  variantId        String? @map("variant_id") @db.Uuid
  quantity         Decimal @db.Decimal(14, 3)
  receivedQuantity Decimal @default(0) @map("received_quantity") @db.Decimal(14, 3)
  unitCost         Decimal @map("unit_cost") @db.Decimal(15, 2)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxRate          Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount        Decimal @default(0) @map("tax_amount") @db.Decimal(15, 2)
  total            Decimal @db.Decimal(15, 2)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@map("purchase_items")
}

// ──────────────────────── Cash & expenses ────────────────────────

// A physical till / terminal
model CashRegister {
  id        String       @id @default(uuid()) @db.Uuid
  branchId  String       @map("branch_id") @db.Uuid
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  branch   Branch                @relation(fields: [branchId], references: [id])
  sessions CashRegisterSession[]

  @@unique([branchId, name])
  @@map("cash_registers")
}

// A shift on a register: OPEN → CLOSE
model CashRegisterSession {
  id             String                @id @default(uuid()) @db.Uuid
  registerId     String                @map("register_id") @db.Uuid
  branchId       String                @map("branch_id") @db.Uuid
  openedById     String                @map("opened_by_id") @db.Uuid
  closedById     String?               @map("closed_by_id") @db.Uuid
  status         RegisterSessionStatus @default(OPEN)
  openingAmount  Decimal               @map("opening_amount") @db.Decimal(15, 2)
  expectedAmount Decimal?              @map("expected_amount") @db.Decimal(15, 2)
  countedAmount  Decimal?              @map("counted_amount") @db.Decimal(15, 2)
  difference     Decimal?              @db.Decimal(15, 2)
  openingNote    String?               @map("opening_note")
  closingNote    String?               @map("closing_note")
  openedAt       DateTime              @default(now()) @map("opened_at")
  closedAt       DateTime?             @map("closed_at")

  register  CashRegister   @relation(fields: [registerId], references: [id])
  openedBy  User           @relation("SessionOpenedBy", fields: [openedById], references: [id])
  closedBy  User?          @relation("SessionClosedBy", fields: [closedById], references: [id])
  movements CashMovement[]
  sales     Sale[]

  @@index([branchId, openedAt])
  @@index([openedById, status])
  @@map("cash_register_sessions")
}

model CashMovement {
  id            String           @id @default(uuid()) @db.Uuid
  sessionId     String           @map("session_id") @db.Uuid
  type          CashMovementType
  amount        Decimal          @db.Decimal(15, 2) // signed
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id") @db.Uuid
  reference     String?
  note          String?
  userId        String           @map("user_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")

  session CashRegisterSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId])
  @@map("cash_movements")
}

model ExpenseCategory {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")

  expenses Expense[]

  @@map("expense_categories")
}

model Expense {
  id                String        @id @default(uuid()) @db.Uuid
  branchId          String        @map("branch_id") @db.Uuid
  categoryId        String        @map("category_id") @db.Uuid
  amount            Decimal       @db.Decimal(15, 2)
  description       String?
  expenseDate       DateTime      @map("expense_date") @db.Date
  paymentMethodCode String        @map("payment_method_code")
  reference         String?
  registerSessionId String?       @map("register_session_id") @db.Uuid
  status            ExpenseStatus @default(RECORDED)
  voidReason        String?       @map("void_reason")
  voidedById        String?       @map("voided_by_id") @db.Uuid
  voidedAt          DateTime?     @map("voided_at")
  userId            String        @map("user_id") @db.Uuid
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  branch   Branch          @relation(fields: [branchId], references: [id])
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([branchId, expenseDate])
  @@map("expenses")
}

// ──────────────────────── Audit & notifications ────────────────────────

// Append-only. UPDATE/DELETE blocked by trigger.
model AuditLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @map("user_id") @db.Uuid
  branchId    String?     @map("branch_id") @db.Uuid
  action      AuditAction
  module      String
  recordId    String?     @map("record_id")
  description String?
  metadata    Json?
  ipAddress   String?     @map("ip_address")
  userAgent   String?     @map("user_agent")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([branchId])
  @@map("audit_logs")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  branchId  String?          @map("branch_id") @db.Uuid
  type      NotificationType
  title     String
  message   String
  // Dedup key so the same low-stock alert is not repeated while unresolved
  dedupKey  String?          @map("dedup_key")
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  branch Branch? @relation(fields: [branchId], references: [id])

  @@index([branchId, createdAt])
  @@index([dedupKey])
  @@map("notifications")
}
