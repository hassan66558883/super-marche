# ─── Server ───
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Behind Nginx in production set to 1
TRUST_PROXY=0

# ─── Database ───
DATABASE_URL=postgresql://technova:CHANGE_ME@localhost:5432/technova?schema=public

# ─── Auth ───
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=15m
# Refresh token lifetime (hours) without / with "remember me"
REFRESH_TTL_HOURS=12
REFRESH_TTL_REMEMBER_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Lock account after N failed logins for M minutes
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ─── Company defaults ───
DEFAULT_CURRENCY=XAF
DEFAULT_LOCALE=fr
TZ=Africa/Ndjamena
